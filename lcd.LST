                       241     
  8000                 242     LCD_CMD   EQU 08000H    ; command register address
  8001                 243     LCD_DAT   EQU 08001H    ; data register address
  0010                 244     LCD_RESET EQU 10H       ; P4.4 reset
                       245     
                       246     ;
                       247     ; subroutines wcom and w_com_a
                       248     ;   Writes a byte to the LCD command register after checking the busy flag first
                       249     ;   Assumes the external memory inter/./
                       250     ;face is configured for split mode with bank
                       251     ;   select.
                       252     ; inputs:
                       253     ;   wcom:   r0  = byte to write to command register
                       254     ;   wcom_a: acc = byte to write to command register
                       255     ; outputs: none
                       256     ; destroys:
                       257     ;   wcom:   EMI0CN, r1
                       258     ;   wcom_a: EMI0CN, r0, r1
                       259     ;
                       260     WCOM_A: 
0000    F8             261     MOV R0,A ; save acc in R0 while we check BUSY
                       262     WCOM: 
0001    75AF80         263     MOV EMI0CN , # HIGH 32768 
0004    7900           264     MOV R1 , # LOW 32768 
                       265     WCOM1: 
0006    E3             266     MOVX A,@R1 ; get status register
0007    20E7FC         267     JB ACC.7,WCOM1 ; wait for not BUSY
000A    E8             268     MOV A,R0 ; get the actual data to write
000B    F3             269     MOVX @R1,A ; write the command
000C    22             270     RET
                       271     
                       272     ;
                       273     ; subroutines wdat and w_dat_a and w_datc
                       274     ;   Writes a byte to the LCD data register after checking the busy flag first
                       275     ;   Assumes the external memory interface is configured for split mode with bank
                       276     ;   select.
                       277     ; inputs:
                       278     ;   wdat:   r0  = byte to write to data register
                       279     ;   wdat_a: acc = byte to write to data register
                       280     ;   wdat_c: acc = dptr-relative index (dptr[acc]) of byte to write to data register
                       281     ; outputs: none
                       282     ; destroys:
                       283     ;   wdat:   EMI0CN, r1
                       284     ;   wdat_a: EMI0CN, r0, r1
                       285     ;   wdat_c: EMI0CN, r0, r1
                       286     ;
                       287     WDAT_C: 
000D    93             288     MOVC A,@A+DPTR ; lookup byte to write (handy for fonts)
                       289     WDAT_A: 
000E    F8             290     MOV R0,A ; save it in R0 while we check BUSY
                       291     WDAT: 
000F    75AF80         292     MOV EMI0CN , # HIGH 32768 
0012    7900           293     MOV R1 , # LOW 32768 
                       294     WDAT1: 
0014    E3             295     MOVX A,@R1 ; get status register
0015    20E7FC         296     JB ACC.7,WDAT1 ; wait for not BUSY
0018    09             297     INC R1 ; point to data register
0019    E8             298     MOV A,R0 ; actual data to write
001A    F3             299     MOVX @R1,A ; write the data
001B    22             300     RET
                       301     
                       302     ;
                       303     ; Initialize controller for S64128N LCD module
                       304     ;   inputs: none
                       305     ;   outputs: none
                       306     ;   destroys: r0, r2, r3, dptr
                       307     ;
                       308     INIT_LCD: 
001C    7584EF         309     MOV P4 , # NOT 16 
001F    75A338         310     MOV EMI0CF,#038H     ; P4-7, non-muxed, split bank
0022    75A10C         311     MOV EMI0TC,#00CH     ; pulse width 4 sysclock cycles
0025    75B5FF         312     MOV P74OUT,#0FFH     ; push-pull
0028    438410         313     ORL P4 , # 16 
                       314     
002B    782F           315     MOV R0,#02FH ; Boost on, voltage Reg and follower on
002D    120000   F     316     CALL WCOM
0030    78A2           317     MOV R0,#0A2H ; 1/9 bias selected
0032    120000   F     318     CALL WCOM
0035    78A1           319     MOV R0,#0A1H ; reverse segment driver output seg131-seg0
0037    120000   F     320     CALL WCOM
003A    78C0           321     MOV R0,#0C0H ; common output mode com0 to com63
003C    120000   F     322     CALL WCOM
003F    7824           323     MOV R0,#024H ; Ra/Rb ratio
0041    120000   F     324     CALL WCOM
0044    7881           325     MOV R0,#081H ; electronic volume mode set
0046    120000   F     326     CALL WCOM
0049    7828           327     MOV R0,#028H ; contrast
004B    120000   F     328     CALL WCOM
004E    7840           329     MOV R0,#040H ; display line address = 0
0050    120000   F     330     CALL WCOM
0053    78A6           331     MOV R0,#0A6H ; normal video
0055    120000   F     332     CALL WCOM
0058    78AF           333     MOV R0,#0AFH ; display on
005A    120000   F     334     CALL WCOM
005D    120000   F     335     CALL BLANK_SCREEN ; fall through to refresh_screen
                       336     
                       337     ;
                       338     ; subroutine refresh_screen
                       339     ;   Copies 1k bytes of data from external address 0 to the LCD. Bytes 0-7F go
                       340     ;   into page 0, bytes 80-FF go to page 1 etc.
                       341     ; inputs: none
                       342     ; outputs: none
                       343     ; destroys: r0, r2, r3, dptr, EMI0CN
                       344     ;
                       345     REFRESH_SCREEN: 
0060    900000         346         MOV DPTR,#SCREEN
0063    7AB0           347         MOV R2,#0B0H              ; page 0
                       348     PAGE_LOOP: 
0065    EA             349         MOV A,R2
0066    120000   F     350         CALL WCOM_A               ; set page
                       351     
0069    7404           352         MOV A,#04H
006B    120000   F     353         CALL WCOM_A               ; lower column nibble
006E    7410           354         MOV A,#10H
0070    120000   F     355         CALL WCOM_A               ; upper column nibble
                       356     
0073    7B80           357         MOV R3,#128
                       358     BYTE_LOOP: 
0075    E0             359         MOVX A,@DPTR
0076    120000   F     360         CALL WDAT_A
0079    A3             361         INC DPTR
007A    DBF9           362         DJNZ R3,BYTE_LOOP
                       363     
007C    0A             364         INC R2
007D    BAB8E5         365         CJNE R2,#0B8H,PAGE_LOOP
0080    22             366         RET
                       367     
                       368     
                       369     BLANK_SCREEN: 
0081    900000         370         MOV DPTR,#SCREEN
0084    E4             371         CLR A
                       372     BLANK_LOOP: 
0085    F0             373         MOVX @DPTR,A
0086    A3             374         INC DPTR
0087    8583F0         375         MOV B,DPH
008A    30F2F8         376         JNB B.2,BLANK_LOOP
008D    22             377         RET
                       378     
